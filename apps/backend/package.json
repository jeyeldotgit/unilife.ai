{
  "name": "@unilife-ai/backend",
  "type": "module",
  "private": true,
  "scripts": {
    "pretest": "pnpm --filter @unilife-ai/ai-core --filter @unilife-ai/database build",
    "dev": "tsx watch --tsconfig tsconfig.json src/index.ts",
    "prebuild": "pnpm --filter @unilife-ai/ai-core --filter @unilife-ai/database build",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "@trpc/server": "^11.17.0",
    "@unilife-ai/ai-core": "workspace:*",
    "@unilife-ai/database": "workspace:*",
    "@unilife-ai/types": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.43.1",
    "hono": "^4.12.23",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
